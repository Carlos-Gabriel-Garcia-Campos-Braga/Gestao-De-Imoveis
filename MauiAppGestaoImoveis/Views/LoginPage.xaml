<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppGestaoImoveis.Views.LoginPage"
             Title=""
             >
    <VerticalStackLayout Spacing="8" Padding="10">
        <Label Text="Bem-Vindo ao Gestão de Imóveis Brandão"
               HorizontalTextAlignment="Center"
               FontSize="Title"/>

        <Label Text="E-mail" x:Name="EmailLabel"/>
        <Entry x:Name="EmailInput" Placeholder="Digite seu E-mail"/>

        <Label Text="Senha" x:Name="SenhaLabel"/>
        <HorizontalStackLayout Spacing="5">
            <Entry x:Name="SenhaInput"
                Placeholder="Digite sua Senha"
                IsPassword="{Binding IsPassword, Mode=TwoWay}"
                WidthRequest="250"
                HorizontalOptions="StartAndExpand"/>

            <ImageButton Source="{Binding EyeIcon}"
                        BackgroundColor="Transparent"
                        Clicked="OnTogglePasswordVisibility"
                        WidthRequest="30"
                        HeightRequest="30" />
        </HorizontalStackLayout>

        <Button x:Name="LoginButton" Clicked="LoginButton_Clicked" Text="Login"/>
    </VerticalStackLayout>
</ContentPage>