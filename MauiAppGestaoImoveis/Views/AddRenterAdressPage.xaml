<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAppGestaoImoveis.ViewModels"
             x:Class="MauiAppGestaoImoveis.Views.AddRenterAdressPage"
             Title="AddRenterAdressPage">

    <VerticalStackLayout>
        <Label Text="Rua"/>
        <Entry Text="{Binding Logradouro}" Placeholder="Rua"/>

        <Label Text="Complemento"/>
        <Entry Text="{Binding Complemento}" Placeholder="Complemento"/>

        <Label Text="Número"/>
        <Entry Text="{Binding Numero}" Placeholder="Número"/>

        <Label Text="Bairro/Setor"/>
        <Entry Text="{Binding Bairro}" Placeholder="Bairro/Setor"/>

        <Label Text="Cidade"/>
        <Entry Text="{Binding Cidade}"  Placeholder="Cidade"/>

        <Label Text="Estado"/>
        <Entry Text="{Binding Estado}"  Placeholder="Estado"/>

        <Label Text="CEP"/>
        <Entry Text="{Binding Cep}"  Placeholder="CEP" />

        <Button Text="Próximo" Command="{Binding NextStepCommand}"/>
    </VerticalStackLayout>
</ContentPage>